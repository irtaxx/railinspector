[Unit]
Description=RailInspector API (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
# Ganti "railinspector" di bawah kalau username VPS kamu beda,
# dan sesuaikan path kalau repo di-clone bukan ke home directory.
User=railinspector
WorkingDirectory=/home/railinspector/railinspector/backend
ExecStart=/home/railinspector/railinspector/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
